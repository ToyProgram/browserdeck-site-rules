{
  "schemaVersion": 1,
  "version": 3,
  "sites": [
    {
      "hosts": ["chatgpt.com", "chat.openai.com"],
      "rules": [
        {
          "id": "chatgpt-sidebar",
          "type": "alternateAction",
          "on": "[data-sidebar-trigger]",
          "action": { "kind": "scrollToStart", "target": "[data-swipe-scroll-container]" }
        },
        {
          "id": "chatgpt-sidebar-close",
          "type": "alternateAction",
          "on": "[data-swipe-visual-viewport], [data-octane-sidebar-popover], [data-swipe-gesture-track]",
          "except": "[data-octane-sidebar-pane]",
          "action": { "kind": "scrollToEnd", "target": "[data-swipe-scroll-container]" }
        }
      ]
    }
  ]
}
